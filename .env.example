# Public site URL (used for metadataBase / JSON-LD). e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (spam check on the forms) — dash.cloudflare.com > Turnstile.
# For local development use Cloudflare's test keys, which always pass:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# EmailJS private key — dashboard > Account > Security. Server only: never prefix
# with NEXT_PUBLIC_. Also turn on "Allow EmailJS API for non-browser applications"
# and "Use Private Key" on that page.
EMAILJS_PRIVATE_KEY=

# Optional EmailJS overrides — defaults in app/api/contact/route.ts match the old narf2.0 form.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
